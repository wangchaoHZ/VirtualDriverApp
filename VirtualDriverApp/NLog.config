<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://nlog.org/schema"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://nlog.org/schema NLog.xsd"
      throwConfigExceptions="true">
  <targets>
    <!--
      日志先进入内存队列，再由后台线程批量写入。
      队列满时阻塞调用方而不是丢弃日志，保证故障日志完整。
    -->
    <target name="asyncFile"
            xsi:type="AsyncWrapper"
            queueLimit="10000"
            overflowAction="Block"
            batchSize="100">
      <!--
        每个自然日使用一个文件，例如 app_log_2026-07-29.log。
        不设置自动清理策略，所有历史日志长期保留。
      -->
      <target name="dailyFile"
              xsi:type="File"
              fileName="${basedir}/logs/app_log_${shortdate}.log"
              layout="${longdate} [${level:uppercase=true}] ${message} ${exception:format=tostring}"
              encoding="utf-8"
              keepFileOpen="true"
              concurrentWrites="false"
              openFileCacheSize="2"
              openFileCacheTimeout="60"
              autoFlush="false"
              openFileFlushTimeout="1" />
    </target>
  </targets>

  <rules>
    <logger name="*" minlevel="Info" writeTo="asyncFile" />
  </rules>
</nlog>
